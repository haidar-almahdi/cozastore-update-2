@startuml مخطط النشاط - إنشاء طلب

start

:المستخدم ينتقل إلى السلة;

if (السلة فارغة؟) then (نعم)
  :عرض رسالة "السلة فارغة";
  stop
else (لا)
  :عرض منتجات السلة والإجمالي;
endif

:المستخدم يضغط على "الدفع";

:الانتقال لصفحة الدفع;

:عرض نموذج الطلب:
- اسم المستلم
- رقم الهاتف
- عنوان الشحن
- ملاحظات الطلب;

:المستخدم يملأ بيانات الطلب;

if (جميع الحقول المطلوبة معبأة؟) then (لا)
  :عرض أخطاء التحقق;
  stop
else (نعم)
  :المستخدم يضغط على "إنشاء الطلب";
endif

:التحقق من بيانات الطلب;

if (التحقق ناجح؟) then (لا)
  :عرض رسالة خطأ;
  stop
else (نعم)
  :التحقق من توفر المنتجات;
endif

if (جميع المنتجات متوفرة؟) then (لا)
  :عرض رسالة "غير متوفر";
  :عرض قائمة المنتجات غير المتوفرة;
  stop
else (نعم)
  :إنشاء طلب جديد;
endif

:توليد رقم طلب فريد;

:تعيين حالة الطلب "معلق";

:حساب الإجمالي الكلي;

:حفظ الطلب في قاعدة البيانات;

fork
  :إنشاء عناصر الطلب من السلة;

  :لكل عنصر في السلة:
  - نسخ تفاصيل المنتج
  - نسخ الكمية، السعر، المقاس، اللون
  - ربط العنصر بالطلب;

fork again
  :تحديث مخزون المنتجات;

  :لكل منتج:
  - تقليل المخزون بمقدار الكمية;

fork again
  :منح نقاط الولاء;

  :حساب النقاط (1% من إجمالي الطلب);

  :إنشاء معاملة نقاط ولاء;

end fork

:إفراغ سلة المستخدم;

:إعادة التوجيه لصفحة "نجاح الطلب";

:عرض تأكيد الطلب:
- رقم الطلب
- تفاصيل الطلب
- الإجمالي الكلي
- تاريخ التسليم المتوقع;

:إرسال بريد تأكيد (اختياري);

stop

@enduml
