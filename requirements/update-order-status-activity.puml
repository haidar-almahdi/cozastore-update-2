@startuml مخطط النشاط - تحديث حالة الطلب

start

:المدير يفتح تفاصيل الطلب;

:عرض الحالة الحالية;

:المدير يختار الحالة الجديدة;

:المدير يضغط على "تحديث";

:التحقق من صحة الحالة;

if (الحالة صحيحة؟) then (لا)
  :عرض رسالة خطأ;
  stop
endif

if (الحالة الجديدة = "ملغي"؟) then (نعم)
  :إرجاع المخزون;
  :تحديث كميات المنتجات;
endif

:تحديث حالة الطلب;

fork
  :عرض رسالة نجاح;
fork again
  :إرسال إشعار للمستخدم;
end fork

stop

@enduml
