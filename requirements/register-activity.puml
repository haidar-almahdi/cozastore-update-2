@startuml مخطط النشاط - تسجيل حساب جديد

start

:الزائر يفتح صفحة التسجيل;

:عرض نموذج التسجيل;

:الزائر يدخل البيانات:
- الاسم
- البريد الإلكتروني
- كلمة المرور
- تأكيد كلمة المرور;

:الزائر يضغط "Register";

:التحقق من البيانات;

if (جميع الحقول معبأة؟) then (لا)
  :عرض "الحقول المطلوبة فارغة";
  stop
else (نعم)
  :التحقق من صحة البيانات;
endif

if (البريد الإلكتروني صحيح؟) then (لا)
  :عرض "البريد الإلكتروني غير صحيح";
  stop
else (نعم)
  :التحقق من تكرار البريد;
endif

if (البريد مستخدم؟) then (نعم)
  :عرض "البريد الإلكتروني مستخدم بالفعل";
  stop
else (لا)
  :التحقق من كلمة المرور;
endif

if (كلمة المرور >= 8 أحرف؟) then (لا)
  :عرض "كلمة المرور قصيرة جداً";
  stop
else (نعم)
  :التحقق من تطابق كلمات المرور;
endif

if (كلمات المرور متطابقة؟) then (لا)
  :عرض "كلمات المرور غير متطابقة";
  stop
else (نعم)
  :إنشاء حساب جديد;
endif

:تشفير كلمة المرور;

:تعيين الدور "customer";

:حفظ المستخدم في قاعدة البيانات;

:تسجيل دخول المستخدم تلقائياً;

:إنشاء جلسة (Session);

:إعادة توجيه للصفحة الرئيسية;

:عرض رسالة "مرحباً بك!";

stop

@enduml
