@startuml مخطط النشاط - إضافة منتج (Admin)

start

:المدير يضغط "Add Product";

:عرض نموذج إضافة منتج;

:المدير يدخل البيانات;

:المدير يرفع الصور;

:المدير يضغط "Save";

:التحقق من البيانات;

if (البيانات صحيحة؟) then (لا)
  :عرض رسائل خطأ;
  stop
else (نعم)
  :رفع الصور للسيرفر;
endif

:حفظ المنتج الجديد;

:عرض "تم إضافة المنتج بنجاح";

stop

@enduml
