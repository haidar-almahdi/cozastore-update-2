@startuml مخطط النشاط - تصفح المنتجات

start

:المستخدم يضغط على "Shop";

:جلب المنتجات النشطة;

if (يوجد فلتر فئة؟) then (نعم)
  :تصفية المنتجات حسب الفئة;
else (لا)
endif

if (يوجد ترتيب؟) then (نعم)
  :ترتيب المنتجات;
else (لا)
endif

:عرض قائمة المنتجات:
- الصورة
- الاسم
- السعر
- أيقونة المفضلة;

stop

@enduml
