@startuml مخطط النشاط - تسجيل الدخول

start

:المستخدم يفتح صفحة تسجيل الدخول;

:عرض نموذج تسجيل الدخول;

:المستخدم يدخل:
- البريد الإلكتروني
- كلمة المرور
- تذكرني (اختياري);

:المستخدم يضغط "Login";

if (الحقول معبأة؟) then (لا)
  :عرض "الرجاء ملء جميع الحقول";
  stop
else (نعم)
  :التحقق من البيانات;
endif

if (البيانات صحيحة؟) then (لا)
  :عرض "بيانات الدخول غير صحيحة";
  stop
else (نعم)
  :تسجيل دخول المستخدم;
endif

:إنشاء جلسة (Session);

if (تذكرني مفعل؟) then (نعم)
  :إنشاء Remember Token;
else (لا)
endif

:إعادة توجيه للصفحة المطلوبة;

stop

@enduml
