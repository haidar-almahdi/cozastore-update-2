@startuml مخطط النشاط - حذف منتج من المفضلة

start

:المستخدم يضغط على أيقونة القلب الممتلئة;

if (المستخدم مسجل دخول؟) then (لا)
  :عرض رسالة "يجب تسجيل الدخول";
  :إعادة التوجيه لصفحة تسجيل الدخول;
  stop
else (نعم)
  :التحقق من المفضلة;
endif

if (المنتج موجود في المفضلة؟) then (لا)
  :عرض رسالة "غير موجود في المفضلة";
  stop
else (نعم)
  :حذف السجل من favorites;
endif

if (الحذف ناجح؟) then (لا)
  :عرض رسالة خطأ;
  :تسجيل الخطأ في Logs;
  stop
else (نعم)
  fork
    :تحديث أيقونة القلب (♡);
  fork again
    :تحديث عداد المفضلة;
  fork again
    :عرض رسالة نجاح;
  fork again
    if (في صفحة المفضلة؟) then (نعم)
      :إزالة المنتج من القائمة;
    endif
  end fork
endif

stop

@enduml
