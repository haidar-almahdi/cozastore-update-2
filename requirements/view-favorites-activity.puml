@startuml مخطط النشاط - عرض صفحة المفضلة

start

:المستخدم يضغط على أيقونة المفضلة;

if (المستخدم مسجل دخول؟) then (لا)
  :إعادة التوجيه لصفحة تسجيل الدخول;
  stop
else (نعم)
  :الانتقال لصفحة المفضلة;
endif

:جلب قائمة المنتجات المفضلة للمستخدم;

if (قائمة المفضلة فارغة؟) then (نعم)
  :عرض رسالة "قائمة المفضلة فارغة";
  :عرض زر "تصفح المنتجات";
  stop
else (لا)
  :جلب تفاصيل المنتجات;
endif

:التحقق من حالة توفر كل منتج;

:عرض المنتجات في شبكة (Grid);

:لكل منتج عرض:
- صورة المنتج
- اسم المنتج
- السعر
- حالة التوفر
- زر إزالة من المفضلة
- زر إضافة للسلة;

if (عدد المنتجات > 12؟) then (نعم)
  :عرض Pagination;
else (لا)
  :عرض جميع المنتجات;
endif

:المستخدم يتفاعل مع المنتجات;

stop

@enduml
