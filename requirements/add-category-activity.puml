@startuml مخطط النشاط - إضافة فئة

start

:المدير يضغط على "إضافة فئة";

:عرض نموذج الإضافة;

:المدير يدخل البيانات:
- اسم الفئة
- الوصف
- الصورة
- الحالة;

:المدير يضغط على "حفظ";

:التحقق من صحة البيانات;

if (البيانات صحيحة؟) then (لا)
  :عرض رسائل الخطأ;
  stop
else (نعم)
  :التحقق من عدم تكرار الاسم;
endif

if (الاسم مكرر؟) then (نعم)
  :عرض رسالة "الاسم موجود مسبقاً";
  stop
else (لا)
  :توليد slug فريد;
endif

if (يوجد صورة؟) then (نعم)
  :رفع الصورة;
  :حفظ مسار الصورة;
endif

:حفظ الفئة في قاعدة البيانات;

:عرض رسالة نجاح;

:إعادة التوجيه لصفحة الفئات;

stop

@enduml
