@startuml مخطط النشاط - إضافة منتج للسلة

start

:المستخدم يتصفح المنتجات;

:المستخدم يضغط على منتج;

:عرض صفحة تفاصيل المنتج;

if (المنتج متوفر؟) then (لا)
  :عرض "المنتج غير متوفر";
  :تعطيل زر "إضافة للسلة";
  stop
else (نعم)
  :عرض خيارات المنتج;
endif

:المستخدم يختار المقاس (اختياري);

:المستخدم يختار اللون (اختياري);

:المستخدم يحدد الكمية;

:المستخدم يضغط "Add to Cart";

if (المستخدم مسجل دخول؟) then (لا)
  :إعادة توجيه لصفحة تسجيل الدخول;
  stop
else (نعم)
  :التحقق من البيانات;
endif

if (الكمية صحيحة؟) then (لا)
  :عرض رسالة خطأ;
  stop
else (نعم)
  :التحقق من المخزون;
endif

if (الكمية متوفرة في المخزون؟) then (لا)
  :عرض "الكمية غير متوفرة";
  :عرض الكمية المتوفرة;
  stop
else (نعم)
  :البحث عن سلة نشطة;
endif

if (يوجد سلة نشطة؟) then (لا)
  :إنشاء سلة جديدة;
else (نعم)
  :استخدام السلة الموجودة;
endif

:البحث عن المنتج في السلة\n(نفس المقاس واللون);

if (المنتج موجود في السلة؟) then (نعم)
  :زيادة الكمية;
  :التحقق من عدم تجاوز المخزون;
else (لا)
  :إضافة عنصر جديد للسلة;
endif

:حفظ التغييرات;

:تحديث عداد السلة;

:عرض رسالة نجاح;

stop

@enduml
