@startuml CozaStore Use Case Diagram - High Level (English)

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
skinparam nodesep 100
skinparam ranksep 100

' Actors
actor "Admin" as Admin
actor "Customer" as Customer
actor "Guest" as Guest

' Inheritance
Customer --|> Guest
Admin --|> Customer

rectangle "CozaStore System" {

    package "Public Features" {
        usecase "Browse & Search Products" as UC_Browse
        usecase "Register & Login" as UC_Auth
        usecase "View Static Pages" as UC_Static
    }

    package "Customer Features" {
        usecase "Manage Shopping Cart" as UC_Cart
        usecase "Place & Manage Orders" as UC_Order
        usecase "Manage Profile & Favorites" as UC_Profile
        usecase "Interact (Rate/Comment)" as UC_Interact
        usecase "Contact Store" as UC_Contact
    }

    package "Admin Features" {
        usecase "Manage Products & Categories" as UC_ManageProducts
        usecase "Manage Orders" as UC_ManageOrders
        usecase "Manage Users" as UC_ManageUsers
        usecase "Manage Messages" as UC_ManageMessages
        usecase "View Dashboard" as UC_Dashboard
    }
}

' Layout Hints
Customer -[hidden]d- Guest

' Relationships - Admin (Left)
Admin --> UC_ManageProducts
Admin --> UC_ManageOrders
Admin --> UC_ManageUsers
Admin --> UC_ManageMessages
Admin --> UC_Dashboard

' Relationships - Guest (Right)
UC_Browse <-- Guest
UC_Auth <-- Guest
UC_Static <-- Guest

' Relationships - Customer (Right)
UC_Cart <-- Customer
UC_Order <-- Customer
UC_Profile <-- Customer
UC_Interact <-- Customer
UC_Contact <-- Customer

@enduml
