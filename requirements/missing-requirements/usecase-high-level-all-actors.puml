@startuml Use Case High Level - All Actors
left to right direction
skinparam packageStyle rectangle

actor Guest
actor Customer
actor Admin
actor Driver

rectangle "CozaStore System" {
  usecase "Browse Catalog" as UC_Browse
  usecase "Authenticate Account" as UC_Auth
  usecase "Shop & Checkout" as UC_Shop
  usecase "Manage Profile & Favorites" as UC_Profile
  usecase "Manage Orders (Customer)" as UC_CustOrders
  usecase "Manage Store Backoffice" as UC_Admin
  usecase "Deliver Orders" as UC_Driver
}

Guest --> UC_Browse
Guest --> UC_Auth

Customer --> UC_Browse
Customer --> UC_Shop
Customer --> UC_Profile
Customer --> UC_CustOrders

Admin --> UC_Admin
Driver --> UC_Driver
@enduml
