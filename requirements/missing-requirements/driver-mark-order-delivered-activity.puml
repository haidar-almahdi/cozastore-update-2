@startuml
start
:السائق يضغط تم التوصيل;
if (الطلب مسند لنفس السائق؟) then (نعم)
  if (الحالة ليست completed؟) then (نعم)
    :تحديث الحالة إلى completed;
    :منح المستخدم 3 نقاط;
    :عرض نجاح;
  else (لا)
    :عرض مكتمل مسبقاً;
  endif
else (لا)
  :رفض العملية;
  :عرض خطأ صلاحية;
endif
stop
@enduml
