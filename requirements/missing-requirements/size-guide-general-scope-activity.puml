@startuml
start
:طلب عرض دليل مقاسات المنتج;
:بحث عن دليل خاص بالمنتج;
if (موجود؟) then (نعم)
  :عرض دليل المنتج;
else (لا)
  :بحث عن دليل الفئة;
  if (موجود؟) then (نعم)
    :عرض دليل الفئة;
  else (لا)
    :بحث عن دليل عام;
    if (موجود؟) then (نعم)
      :عرض الدليل العام;
    else (لا)
      :عرض لا يوجد دليل;
    endif
  endif
endif
stop
@enduml
