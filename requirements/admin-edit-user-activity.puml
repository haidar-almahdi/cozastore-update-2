@startuml مخطط النشاط - تعديل مستخدم (Admin)

start

:المدير يضغط "Edit" على مستخدم;

:عرض نموذج التعديل مع البيانات الحالية;

:المدير يعدل البيانات;

:المدير يضغط "Update";

:التحقق من البيانات;

if (البيانات صحيحة؟) then (لا)
  :عرض رسائل خطأ;
  stop
else (نعم)
  :تحديث بيانات المستخدم;
endif

:عرض "تم التحديث بنجاح";

stop

@enduml
