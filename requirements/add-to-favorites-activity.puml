@startuml مخطط النشاط - إضافة منتج للمفضلة

start

:المستخدم يضغط على أيقونة القلب;

if (المستخدم مسجل دخول؟) then (لا)
  :عرض رسالة "يجب تسجيل الدخول";
  :إعادة التوجيه لصفحة تسجيل الدخول;
  stop
else (نعم)
  :التحقق من المنتج;
endif

if (المنتج موجود ونشط؟) then (لا)
  :عرض رسالة "المنتج غير متوفر";
  stop
else (نعم)
  :التحقق من المفضلة;
endif

if (المنتج موجود في المفضلة؟) then (نعم)
  :عرض رسالة "موجود بالفعل";
  stop
else (لا)
  :إنشاء سجل جديد في favorites;
endif

:ربط المنتج بالمستخدم;

:حفظ في قاعدة البيانات;

fork
  :تحديث أيقونة القلب (♥);
fork again
  :تحديث عداد المفضلة;
fork again
  :عرض رسالة نجاح;
end fork

stop

@enduml
