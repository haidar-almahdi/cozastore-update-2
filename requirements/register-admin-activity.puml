@startuml مخطط النشاط - تسجيل مدير جديد

start

:فتح صفحة تسجيل المدير;

:عرض نموذج التسجيل;

:إدخال البيانات;

:الضغط على "Register";

:التحقق من البيانات;

if (البريد مكرر؟) then (نعم)
  :عرض "البريد مستخدم";
  stop
else (لا)
  :إنشاء حساب جديد;
endif

:تعيين الدور "admin";

:تسجيل دخول تلقائي;

:إعادة توجيه للوحة التحكم;

stop

@enduml
