@startuml مخطط النشاط - إرسال رسالة للإدارة

start

:المستخدم يفتح صفحة "Contact";

:عرض نموذج الاتصال;

:المستخدم يدخل:
- الاسم
- البريد الإلكتروني
- الموضوع
- الرسالة;

:المستخدم يضغط "Send";

:التحقق من البيانات;

if (البيانات صحيحة؟) then (لا)
  :عرض رسائل خطأ;
  stop
else (نعم)
  :حفظ الرسالة;
endif

:عرض "تم إرسال رسالتك بنجاح";

stop

@enduml
