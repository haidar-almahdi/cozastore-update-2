@startuml مخطط النشاط - إدارة المفضلة

start

:المستخدم يتصفح المنتجات;

:عرض أيقونة القلب لكل منتج;

:المستخدم يضغط على أيقونة القلب;

if (المستخدم مسجل دخول؟) then (لا)
  :إعادة توجيه لصفحة تسجيل الدخول;
  stop
else (نعم)
  :التحقق من حالة المنتج في المفضلة;
endif

if (المنتج في المفضلة؟) then (نعم)
  :إزالة المنتج من المفضلة;
  :تفريغ أيقونة القلب;
  :عرض "تمت الإزالة من المفضلة";
else (لا)
  :إضافة المنتج للمفضلة;
  :ملء أيقونة القلب;
  :عرض "تمت الإضافة للمفضلة";
endif

:تحديث الواجهة;

stop

@enduml
