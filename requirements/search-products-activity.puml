@startuml مخطط النشاط - البحث عن المنتجات

start

:المستخدم يدخل كلمة بحث;

if (الكلمة >= 2 حرف؟) then (نعم)
  :عرض اقتراحات سريعة;
else (لا)
endif

:المستخدم يضغط "Search";

:البحث في:
- أسماء المنتجات
- أوصاف المنتجات
- أسماء الفئات;

if (يوجد نتائج؟) then (نعم)
  :عرض قائمة النتائج;
else (لا)
  :عرض "لا توجد نتائج";
endif

stop

@enduml
