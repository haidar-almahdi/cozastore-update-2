@startuml مخطط النشاط - الرد على رسالة

start

:المدير يضغط على رسالة;

:عرض تفاصيل الرسالة;

:عرض الردود السابقة;

:المدير يكتب الرد;

:المدير يضغط على "إرسال";

:التحقق من صحة الرد;

if (الرد صحيح؟) then (لا)
  :عرض رسالة خطأ;
  stop
endif

:إنشاء سجل رد جديد;

:ربط الرد بالرسالة;

:تحديث حالة الرسالة إلى "مقروءة";

fork
  :عرض الرد في القائمة;
fork again
  :عرض رسالة نجاح;
fork again
  if (إرسال إشعار؟) then (نعم)
    :إرسال إشعار للمستخدم;
  endif
end fork

stop

@enduml
