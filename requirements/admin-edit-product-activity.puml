@startuml مخطط النشاط - تعديل منتج (Admin)

start

:المدير يضغط "Edit" على منتج;

:عرض نموذج التعديل مع البيانات الحالية;

:المدير يعدل البيانات;

:المدير يضغط "Update";

:التحقق من البيانات;

if (البيانات صحيحة؟) then (لا)
  :عرض رسائل خطأ;
  stop
else (نعم)
  if (يوجد صور جديدة؟) then (نعم)
    :رفع الصور الجديدة;
  else (لا)
  endif
  :تحديث بيانات المنتج;
endif

:عرض "تم التحديث بنجاح";

stop

@enduml
