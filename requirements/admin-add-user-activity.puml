@startuml مخطط النشاط - إضافة مستخدم (Admin)

start

:المدير يضغط "Add User";

:عرض نموذج إضافة مستخدم;

:المدير يدخل البيانات;

:المدير يضغط "Save";

:التحقق من البيانات;

if (البريد مكرر؟) then (نعم)
  :عرض "البريد مستخدم";
  stop
else (لا)
  :حفظ المستخدم الجديد;
endif

:عرض "تم إضافة المستخدم بنجاح";

stop

@enduml
