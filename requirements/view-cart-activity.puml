@startuml مخطط النشاط - عرض محتويات السلة

start

:المستخدم يضغط على أيقونة السلة;

:جلب السلة النشطة;

if (السلة فارغة؟) then (نعم)
  :عرض "السلة فارغة";
  :عرض رابط "تسوق الآن";
else (لا)
  :عرض محتويات السلة:
  - قائمة المنتجات
  - الكميات
  - الأسعار
  - الإجمالي الفرعي
  - الإجمالي الكلي
  - أزرار الإجراءات;
endif

stop

@enduml
